{
  "name": "project-management-backend",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "typecheck": "tsc -noEmit",
    "postinstall": "prisma skills sync || exit 0",
    "test": "bun test src/tests/unit && bun test src/tests/integration",
    "test:unit": "bun test src/tests/unit",
    "test:integration": "bun test src/tests/integration",
    "test:db:setup": "bun src/tests/scripts/setup-test-db.ts",
    "test:db:reset": "bun src/tests/scripts/reset-test-db.ts",
    "test:serve": "bun src/tests/scripts/serve-test.ts",
    "db:migrate": "dbmate --migrations-dir db/migrations --no-dump-schema up",
    "db:rollback": "dbmate --migrations-dir db/migrations --no-dump-schema rollback",
    "db:status": "dbmate --migrations-dir db/migrations --no-dump-schema status"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.1.0",
    "jsonwebtoken": "^9.0.3",
    "ls": "^1.0.0",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}

PORT=3000
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/project-management-sass?sslmode=disable
JWT_SECRET=your_secret

# Google sign-in (OAuth 2.0). Create a "Web application" OAuth client in
# Google Cloud Console → APIs & Services → Credentials and register
# GOOGLE_REDIRECT_URI there as an authorized redirect URI. It points at the
# Vite dev server, which proxies /api to this backend, so cookies stay same-origin.
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback
# Where the browser is sent after the callback.
FRONTEND_URL=http://localhost:5173

# Base URL of the API. Defaults to "/api/v1", which Vite proxies to API_PROXY_TARGET.
# Leave unset for local development.
# VITE_API_URL=/api/v1

# Copy to .env.dev (`bun run dev`) and .env.prod (`bun run dev:prod`):
#   .env.dev   API_PROXY_TARGET=http://localhost:3000
#   .env.prod  API_PROXY_TARGET=https://taskflow-ut0q.onrender.com
API_PROXY_TARGET=http://localhost:3000
